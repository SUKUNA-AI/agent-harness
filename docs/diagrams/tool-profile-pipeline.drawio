  <diagram id="tool-profile-pipeline" name="Tool Profile: политика, клиент и допуск к выполнению">
    <mxGraphModel dx="1680" dy="2020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="2020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Tool Profile: политика, клиент и допуск к выполнению" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;overflow=hidden;fontFamily=Arial;fontSize=32;fontColor=#18324F;" parent="1" vertex="1">
          <mxGeometry x="60" y="35" width="1560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Конфигурация, диагностический каталог, runtime proof и приёмка candidate имеют отдельные критерии." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#18324F;" parent="1" vertex="1">
          <mxGeometry x="60" y="92" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="profiles" value="8 встроенных профилей, version 1&#10;baseline · coding · architecture · reviewer-readonly&#10;browser-testing · documents · coding-context7 · architecture-context7&#10;Docling для documents исключён и не установлен; baseline от него не зависит" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#E8F6F2;strokeColor=#3D8173;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="155" width="1560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="Strict YAML policy → profile/config digest&#10;Backend · role · allow/deny · required dependencies · canonical worktree/cache binding&#10;Render сохраняет выбранные model/provider и native auth; missing required dependency → BLOCKED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="365" width="1560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="probe" value="Dependency preflight / диагностический catalog&#10;Executable + version → contained process → initialize → tools/list → ping → stopped tree&#10;READY подтверждает конкретный probe; не доказывает enforcement будущего model turn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#F0F3F7;strokeColor=#718297;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="555" width="1560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="codex" value="Codex native renderer&#10;mcp_servers · enabled/disabled tools&#10;Disposable app-server catalog без model turn&#10;Диагностика: qualified_for_exec = false" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="760" width="730" height="170" as="geometry" />
        </mxCell>
        <mxCell id="oc" value="OpenCode V2 native renderer&#10;harness-leaf · permissions · deny policies&#10;Code Mode off · pool off&#10;Fresh native permission / catalog / exact-session probes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="890" y="760" width="730" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cxdeny" value="Strict Codex — EXPERIMENTAL transport&#10;Тот же owned app-server thread: census → turn → census&#10;0.167.0: проверен scripted provider; paid workload UNQUALIFIED&#10;Fresh runtime qualification перед каждым новым run&#10;Без доказательства → BLOCKED_NOT_QUALIFIED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#FFF3E0;strokeColor=#B7802F;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1010" width="730" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ocguard" value="Реальный OpenCode invocation + private guard&#10;Role / wire catalog audit → before_dispatch&#10;after_response: actual EOF или confirmed consumer cancel&#10;Read error / failed cancel / disconnect не дают receipt&#10;Native clean stop и полный JSONL обязательны отдельно" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="890" y="1010" width="730" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pin" value="Durable completion receipt — совместное доказательство&#10;Exact session · client/profile/config/source digests · usage · pinned JSONL/catalog&#10;Native finish + exit 0 + process tree stopped; неполный JSONL / finish → UNKNOWN&#10;OpenCode: before_dispatch всегда; при подключённых MCP: before_dispatch + after_response" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#F0F3F7;strokeColor=#718297;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1300" width="1560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Freeze → independent checks / requirements → fresh independent review → final gate&#10;Тот же candidate и актуальные source/tool/index provenance&#10;Только gate подтверждает результат задачи; успешный MCP call не означает ACCEPTED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#E8F1F6;strokeColor=#486B83;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1535" width="1560" height="135" as="geometry" />
        </mxCell>
        <mxCell id="bounds" value="Общая граница&#10;MCP server работает на пользовательском host; OpenRouter — provider модели native OpenCode.&#10;Baseline не требует новых MCP. Нет auto-install tools, новой БД, обязательного daemon или нового model API.&#10;Наблюдённый Hydrogen + Serena + Context7 smoke не является общей квалификацией всех моделей и проектов." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#FFF3E0;strokeColor=#B7802F;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1745" width="1560" height="155" as="geometry" />
        </mxCell>
