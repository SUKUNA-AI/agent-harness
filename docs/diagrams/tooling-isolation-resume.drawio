  <diagram id="tooling-isolation-resume" name="Managed tooling: isolation, exact resume и acceptance">
    <mxGraphModel dx="1680" dy="1850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Managed tooling: isolation, exact resume и acceptance" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;overflow=hidden;fontFamily=Arial;fontSize=32;fontColor=#18324F;" parent="1" vertex="1">
          <mxGeometry x="60" y="35" width="1560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Общий scheduler Codex/OpenCode сохраняет ownership и исходные budgets. Один writer на физический worktree." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#18324F;" parent="1" vertex="1">
          <mxGeometry x="60" y="92" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sup" value="Supervisor: Strict YAML contract / plan + private JSONL journal&#10;DAG · scopes · до 12 managed sessions, включая до 3 reviewers · checkpoints · bounded retry&#10;Codex по умолчанию; OpenCode — optional managed leaf; OpenCode-native subagents NOT_IMPLEMENTED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="155" width="1560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Leaf A: harness-owned worktree A&#10;Canonical cwd A · scope A · own native client&#10;Serena: отдельный server / project / private cache&#10;Context7: public docs / native connection&#10;Finite browser context A + private artifacts A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#E8F6F2;strokeColor=#3D8173;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="390" width="730" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b" value="Leaf B: harness-owned worktree B&#10;Canonical cwd B · scope B · own native client&#10;Serena: другой server / project / private cache&#10;Нет shared mutable project instance&#10;Finite browser context B + private artifacts B" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#E8F6F2;strokeColor=#3D8173;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="890" y="390" width="730" height="190" as="geometry" />
        </mxCell>
        <mxCell id="receipts" value="Invocation → durable completion receipts&#10;Exact session · client/profile/config digests · usage · pinned JSONL / catalog / runtime audits&#10;Native finish + exit 0 + stopped process tree; неполные доказательства → UNKNOWN&#10;Graphify index: frozen source + commit/dirty snapshot + config/tool/index digests; drift инвалидирует index" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#F0F3F7;strokeColor=#718297;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="670" width="1560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="interrupt" value="Interruption / unknown outcome&#10;Сначала определить фактический исход&#10;Не повторять invocation вслепую" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#FFF3E0;strokeColor=#B7802F;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="930" width="730" height="130" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="Exact resume reconciliation&#10;Process + session + physical worktree identity&#10;Client / profile / dependencies / source / index provenance" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="890" y="930" width="730" height="130" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="Drift или неполное evidence&#10;BLOCKED / recovery required&#10;--last и пересказ не являются exact resume" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#FFF3E0;strokeColor=#B7802F;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1160" width="730" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cont" value="Продолжение в том же run&#10;Прежние session / backend / worktree&#10;Прежние attempts, tokens и deadline&#10;Checkpoint → bounded retry без новой квоты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#EAF2FB;strokeColor=#53779D;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="890" y="1160" width="730" height="150" as="geometry" />
        </mxCell>
        <mxCell id="integrate" value="Integration и source-bound acceptance&#10;Local checks → scoped integration → integrated checks → freeze&#10;Requirement coverage + independent checks / fresh review → final gate&#10;Completion leaf или успешный MCP call не означает ACCEPTED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#E8F1F6;strokeColor=#486B83;strokeWidth=2;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="60" y="1440" width="1560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="Свежесть сохранённого ACCEPTED&#10;status --verify-evidence сверяет candidate, inputs и artifacts&#10;Изменение bytes / потеря receipt → STALE; история не переписывается" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#18324F;fillColor=#F0F3F7;strokeColor=#718297;strokeWidth=2;spacing=16;" parent="1" vertex="1">
