{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed final review v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "verdict": {
      "enum": [
        "approved",
        "changes_requested",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 16
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "maxLength": 128
          },
          "status": {
            "enum": [
              "accepted",
              "blocked",
              "failed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "status",
          "evidence_ids"
        ]
      }
    },
    "unrepresented_requirements": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "verdict",
    "findings"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "requirements",
          "unrepresented_requirements"
        ]
      }
    }
  ]
}
