{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-relations v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "semantic",
                      "episode",
                      "short_term",
                      "ledger_event",
                      "evidence",
                      "fact"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "project_id",
                  "kind",
                  "id",
                  "generation",
                  "content_digest"
                ]
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "semantic",
                      "episode",
                      "short_term",
                      "ledger_event",
                      "evidence",
                      "fact"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "project_id",
                  "kind",
                  "id",
                  "generation",
                  "content_digest"
                ]
              }
            ]
          },
          "kind": {
            "type": "string",
            "maxLength": 512
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository_identity": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision": {
                "type": "string",
                "maxLength": 512
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "files": {
                "type": "object",
                "maxProperties": 4096,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))(?![\\s\\S]*\\\\)(?![\\s\\S]*:)[\\s\\S]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "toolchain_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "branch": {
                "type": "string",
                "maxLength": 512
              },
              "file_inventory_complete": {
                "type": "boolean"
              },
              "omitted_file_count": {
                "type": "integer",
                "minimum": 0
              },
              "binding_kind": {
                "enum": [
                  "whole_snapshot",
                  "bounded_context"
                ]
              },
              "snapshot_algorithm": {
                "type": "string",
                "maxLength": 512
              },
              "snapshot_ref": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "inventory_policy_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checkout_ref": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checkout_root": {
                "type": "string",
                "maxLength": 512
              },
              "inventory_complete": {
                "type": "boolean"
              },
              "details_complete": {
                "type": "boolean"
              },
              "details_omitted_count": {
                "type": "integer",
                "minimum": 0
              },
              "details_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "context_complete": {
                "type": "boolean"
              },
              "context_path_encoding": {
                "const": "ancestor_relative_v1"
              },
              "context_paths": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "context_omissions": {
                "type": "array",
                "maxItems": 66,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            },
            "required": [
              "repository_identity",
              "revision",
              "snapshot_id",
              "files"
            ]
          }
        },
        "required": [
          "record_id",
          "from",
          "to",
          "kind",
          "provenance"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "repository_identity",
    "records"
  ]
}
