            },
            "suite": {
              "enum": [
                "swe-bench-verified",
                "terminal-bench-2.1",
                "aider-polyglot"
              ]
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "protocol": {
              "enum": [
                "swebench-jsonl-v1",
                "harbor-task-v1",
                "aider-exercism-v1"
              ]
            },
            "entrypoint": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "helpers": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 512
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  }
                },
                "required": [
                  "name",
                  "artifact"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "record_type",
            "suite",
            "revision",
            "protocol",
            "entrypoint",
            "helpers"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "enum": [
                null,
                "python",
                "rust",
                "go",
                "javascript",
                "cpp",
                "java"
              ]
            },
            "base_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "test_files": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            "solution_files": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            "agent_timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "verifier_timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "language",
            "base_commit",
            "test_files",
            "solution_files",
            "agent_timeout_seconds",
            "verifier_timeout_seconds"
          ]
