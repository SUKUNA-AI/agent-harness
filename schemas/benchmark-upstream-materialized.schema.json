        "git_binding": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
