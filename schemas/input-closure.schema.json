{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "input-closure v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "maxLength": 512
    },
    "policy": {
      "const": "physical_regular_tree_including_ignored_v1"
    },
    "entries": {
      "type": "object",
      "maxProperties": 384,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        },
        "required": [
          "kind",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "file"
                }
              },
              "additionalProperties": true
            },
            "then": {
              "required": [
                "sha256",
                "bytes"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "bytes"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "directory_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "root",
    "policy",
    "entries",
    "file_count",
    "directory_count",
    "total_bytes",
    "digest"
  ]
}
