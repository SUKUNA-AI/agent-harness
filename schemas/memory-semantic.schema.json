{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-semantic v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "enum": [
        "architecture",
        "decisions",
        "conventions"
      ]
    },
    "claim": {
      "type": "string",
      "maxLength": 16384
    },
    "source": {
      "type": "string",
      "maxLength": 512
    },
    "actor": {
      "type": "string",
      "maxLength": 512
    },
    "confidence": {
      "enum": [
        "verified",
        "hypothesis"
      ]
    },
    "last_checked": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "maxLength": 512
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))(?![\\s\\S]*\\\\)(?![\\s\\S]*:)[\\s\\S]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "toolchain_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "file_inventory_complete": {
          "type": "boolean"
        },
        "omitted_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "binding_kind": {
          "enum": [
            "whole_snapshot"
          ]
        },
        "snapshot_algorithm": {
          "type": "string",
          "maxLength": 512
        },
        "snapshot_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inventory_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkout_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkout_root": {
          "type": "string",
          "maxLength": 512
        },
        "inventory_complete": {
          "type": "boolean"
        },
        "details_complete": {
          "type": "boolean"
        },
        "details_omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "details_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "repository_identity",
        "revision",
        "snapshot_id",
        "files"
      ]
    },
    "validity_status": {
      "enum": [
        "valid",
        "needs_revalidation",
        "superseded",
        "rejected",
        "expired"
      ]
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "semantic",
                      "episode",
                      "short_term",
                      "ledger_event",
                      "evidence",
                      "fact"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "project_id",
                  "kind",
                  "id",
                  "generation",
                  "content_digest"
                ]
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "semantic",
                      "episode",
                      "short_term",
                      "ledger_event",
                      "evidence",
                      "fact"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "project_id",
                  "kind",
                  "id",
                  "generation",
                  "content_digest"
                ]
              }
            ]
          },
          "kind": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ]
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "kind": {
              "enum": [
                "semantic",
                "episode",
                "short_term",
                "ledger_event",
                "evidence",
                "fact"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "project_id",
            "kind",
            "id",
            "generation",
            "content_digest"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "repository_identity",
    "document",
    "claim",
    "source",
    "actor",
    "confidence",
    "last_checked",
    "provenance",
    "validity_status",
    "relations",
    "supersedes"
  ]
}
