{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-evidence-status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "current",
        "revoked",
        "superseded"
      ]
    },
    "previous_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "generation",
    "status",
    "previous_digest"
  ]
}
