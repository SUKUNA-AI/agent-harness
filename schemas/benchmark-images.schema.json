{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_images"
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "suite": {
            "enum": [
              "swe-bench-verified",
              "terminal-bench-2.1",
              "aider-polyglot",
              "harness-recovery",
              "harness-retrieval-long-task"
            ]
          },
          "image": {
            "type": "string",
            "maxLength": 512
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "platform": {
            "type": "string",
            "maxLength": 512
          },
          "preparation_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "suite",
          "image",
          "digest",
          "platform",
          "preparation_ref"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "images"
  ]
}
