{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-evidence v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "check_id": {
      "type": "string",
      "maxLength": 512
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "path": {
      "type": "string",
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification_method": {
      "enum": [
        "external_observation",
        "core_command_check_v1"
      ]
    },
    "run_dir": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "check_id",
    "candidate_digest",
    "producer",
    "path",
    "sha256",
    "verification_method"
  ]
}
