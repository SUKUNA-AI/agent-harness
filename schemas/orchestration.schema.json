{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/native-agent-harness/orchestration-v1",
  "title": "Read-only native orchestration plan, additive to contract-v1",
  "type": "object",
  "required": ["schema_version", "plan_revision", "contract_digest", "input_digest", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "contract_digest": {"$ref": "#/$defs/sha"},
    "input_digest": {"$ref": "#/$defs/sha"},
    "target_owners": {"type": "integer", "minimum": 2, "maximum": 3, "default": 2},
    "fallback_reason": {"enum": [null, "indivisible", "capacity", "native_unavailable", "user_constraint"]},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "goal", "cwd", "permissions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "role": {"enum": ["owner", "helper", "reviewer"]},
          "goal": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "description": "Existing absolute cwd; independent Git writers require isolated worktrees"},
          "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "write", "test", "external"]}},
          "write_paths": {"type": "array", "items": {"type": "string", "description": "Relative exact path, ** or directory/**; conservative overlap checks"}},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "checks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "state": {"enum": ["planned", "running", "verifying", "ready_for_review", "accepted", "integrated", "blocked", "failed", "cancelled"], "default": "planned"},
          "native_ref": {"type": "string", "minLength": 1},
          "base_revision": {"type": "string", "description": "Observed Git base for this isolated worktree; context alone does not update it"},
          "accepted_result": {"type": "object", "required": ["run_dir", "verdict_digest"], "properties": {"run_dir": {"type": "string"}, "verdict_digest": {"$ref": "#/$defs/sha"}}}
        }
      }
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
