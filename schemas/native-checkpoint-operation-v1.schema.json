{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-checkpoint-operation-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "committed": {
      "const": true
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_path": {
      "type": "string",
      "maxLength": 512
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "committed",
    "request_digest",
    "packet_path",
    "packet_digest"
  ]
}
