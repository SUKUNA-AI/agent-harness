{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "format": {
      "enum": [
        "json",
        "markdown",
        "toon"
      ]
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "maxLength": 512
        },
        "reasoning_requested": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "reasoning_observed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_route_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "client_version": {
          "type": "string",
          "maxLength": 512
        },
        "client_binary_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "harness_build_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tokenizer_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "revision_scope": {
          "const": "observed_identity_only"
        }
      },
      "required": [
        "model",
        "provider",
        "reasoning_requested",
        "reasoning_observed",
        "config_digest",
        "provider_route_digest",
        "tool_config_digest",
        "client_version",
        "client_binary_digest",
        "harness_build_digest",
        "tokenizer_revision",
        "revision_scope"
      ]
    },
    "data_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stdout_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_path": {
      "type": "string",
      "maxLength": 512
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "correct": {
      "type": "boolean"
    },
    "expected_answer": {
      "type": "string",
      "maxLength": 512
    },
    "actual_answer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "execution_status": {
      "type": "string",
      "maxLength": 512
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  },
  "required": [
    "schema_version",
    "format",
    "stdout_digest",
    "raw_path",
    "thread_id",
    "input_tokens",
    "correct",
    "expected_answer",
    "actual_answer"
  ]
}
