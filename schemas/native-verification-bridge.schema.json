{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-verification-bridge v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity_contract": {
      "const": "native-receipt-identity-v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "plan_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "node_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "producer_kind": {
      "type": "string",
      "maxLength": 512
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "maxLength": 512
    },
    "harness_version": {
      "type": "string",
      "maxLength": 512
    },
    "harness_build_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_code_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package_files_examined": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "const": "on_disk_package_and_loaded_producer"
        }
      },
      "required": [
        "package_digest",
        "producer_code_digest",
        "package_files_examined",
        "source"
      ]
    },
    "client_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "capability_receipt_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "input_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 512
          },
          "id": {
            "type": "string",
            "maxLength": 512
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "kind",
          "id",
          "content_digest",
          "scope"
        ]
      }
    },
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "native_verification_bridge"
    },
    "session_id": {
      "type": "string",
      "maxLength": 512
    },
    "execution_owner": {
      "const": "codex_native"
    },
    "verification": {
      "const": "core_gate"
    },
    "acceptance": {
      "const": "accepted"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transfer_projection_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transfer_policy": {
      "const": "native-isolated-content-v1"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_dir": {
      "type": "string",
      "maxLength": 512
    },
    "scheduler_history": {
      "const": "not_claimed"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "session_id",
    "execution_owner",
    "verification",
    "acceptance",
    "candidate_digest",
    "native_source_digest",
    "transfer_projection_digest",
    "transfer_policy",
    "run_id",
    "task_id",
    "attempt_id",
    "contract_digest",
    "verdict_digest",
    "run_dir",
    "created_at",
    "scheduler_history",
    "identity_contract",
    "record_id",
    "project_id",
    "payload_digest",
    "record_digest",
    "run_id",
    "task_id",
    "plan_digest",
    "node_id",
    "attempt_id",
    "invocation_id",
    "producer_id",
    "producer_kind",
    "generation",
    "created_at",
    "harness_version",
    "harness_build_digest",
    "build_provenance",
    "client_version",
    "capability_receipt_ref",
    "input_refs"
  ]
}
