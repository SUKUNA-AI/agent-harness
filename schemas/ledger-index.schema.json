{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger-index v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    }
  },
  "required": [
    "schema_version",
    "events"
  ]
}
