{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "maxLength": 16384
    },
    "node_id": {
      "type": "string",
      "maxLength": 16384
    },
    "attempt_id": {
      "type": "string",
      "maxLength": 16384
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_revision": {
      "type": "string",
      "maxLength": 16384
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "codex",
            "opencode"
          ]
        },
        "executable": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "binary_sha256": {
          "type": "string",
          "maxLength": 16384
        },
        "version": {
          "type": "string",
          "maxLength": 16384
        },
        "profile_id": {
          "type": "string",
          "maxLength": 16384
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_inputs_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_dependencies": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "root": {
          "type": "string",
          "maxLength": 16384
        },
        "directory_identity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "worktree_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "graph_index_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "launch_files_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependency_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cache_root": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "backend",
        "executable",
        "binary_sha256",
        "version",
        "profile_id",
        "profile_version",
        "profile_digest",
        "effective_config_digest",
        "configuration_inputs_digest",
        "catalog_digest",
        "required_dependencies",
        "root",
        "directory_identity",
        "worktree_digest",
        "selection_digest",
        "graph_index_digest",
        "launch_files_digest",
        "dependency_fingerprint",
        "cache_root"
      ]
    },
    "readiness": {
      "const": "READY"
    },
    "created_at": {
      "type": "string",
      "format": "utc"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "attempt_id",
    "repository_identity",
    "base_revision",
    "source_snapshot_digest",
    "identity",
    "readiness",
    "created_at"
  ]
}
