{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_upstream_evaluator"
    },
    "suite": {
      "enum": [
        "swe-bench-verified",
        "terminal-bench-2.1",
        "aider-polyglot"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "protocol": {
      "enum": [
        "swebench-jsonl-v1",
        "harbor-task-v1",
        "aider-exercism-v1"
      ]
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "helpers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "name",
          "artifact"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "suite",
    "revision",
    "protocol",
    "entrypoint",
    "helpers"
  ]
}
