{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "maxLength": 512
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 512
    },
    "task_id": {
      "type": "string",
      "maxLength": 512
    },
    "node_id": {
      "type": "null"
    },
    "attempt_id": {
      "type": "null"
    },
    "invocation_id": {
      "type": "null"
    },
    "producer_id": {
      "const": "explicit-migration"
    },
    "producer_kind": {
      "const": "migration"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "utc"
    },
    "harness_version": {
      "type": "string",
      "maxLength": 512
    },
    "harness_build_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "client_version": {
      "const": "unknown"
    },
    "capability_receipt_ref": {
      "type": "null"
    },
    "input_refs": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "work_state_migration_receipt"
    },
    "operation_id": {
      "type": "string",
      "maxLength": 512
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "committed"
    },
    "source_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "destination_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journal_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backup_manifest": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "material_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage_policy": {
      "const": "preserve_source_trust"
    },
    "assessment": {
      "const": "unassessed"
    }
  },
  "required": [
    "record_id",
    "project_id",
    "run_id",
    "task_id",
    "node_id",
    "attempt_id",
    "invocation_id",
    "producer_id",
    "producer_kind",
    "generation",
    "created_at",
    "harness_version",
    "harness_build_digest",
    "client_version",
    "capability_receipt_ref",
    "input_refs",
    "payload_digest",
    "schema_version",
    "record_type",
    "operation_id",
    "plan_digest",
    "status",
    "source_state_digest",
    "destination_state_digest",
    "journal_hash",
    "backup_manifest",
    "material_digest",
    "usage_policy",
    "assessment"
  ]
}
