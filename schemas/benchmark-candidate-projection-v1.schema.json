{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_candidate_projection"
    },
    "scheme": {
      "const": "ordinary-tree-no-git-v1"
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "mode"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "scheme",
    "files"
  ]
}
