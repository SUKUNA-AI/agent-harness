{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_network_policy"
    },
    "agent_egress": {
      "const": "deny"
    },
    "web_search": {
      "const": "deny"
    },
    "package_fetch": {
      "const": "deny"
    },
    "model_transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 512
        },
        "route_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "provider",
        "route_ref"
      ]
    },
    "boundary_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "agent_egress",
    "web_search",
    "package_fetch",
    "model_transport",
    "boundary_profile_ref"
  ]
}
