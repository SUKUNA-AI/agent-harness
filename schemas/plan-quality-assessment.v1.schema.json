{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mission_generation": {
      "type": "integer",
      "minimum": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_version": {
      "const": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "verdict": {
      "enum": [
        "approved",
        "requires_revision",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "revision_request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "node_ids",
          "reason",
          "revision_request"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "dependency_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "dependency_valid": {
            "type": "boolean"
          },
          "atomicity": {
            "enum": [
              "coherent",
              "too_broad",
              "too_fragmented"
            ]
          },
          "atomicity_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "indivisibility_condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "scope_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "local_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "integration_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "local_check_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "integration_check_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "checks_meaningful": {
            "type": "boolean"
          },
          "review_handoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "budget_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "shared_interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                },
                "consumers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                    "maxLength": 128
                  },
                  "maxItems": 128,
                  "uniqueItems": true
                }
              },
              "required": [
                "name",
                "owner",
                "consumers"
              ]
            },
            "maxItems": 128
          }
        },
        "required": [
          "node_id",
          "outcome",
          "requirement_ids",
          "depends_on",
          "dependency_rationale",
          "dependency_valid",
          "atomicity",
          "atomicity_rationale",
          "indivisibility_condition",
          "owner",
          "scope_rationale",
          "local_checks",
          "integration_checks",
          "local_check_rationale",
          "integration_check_rationale",
          "checks_meaningful",
          "review_handoff",
          "budget_rationale",
          "shared_interfaces"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "mission_digest",
    "mission_generation",
    "contract_digest",
    "plan_revision",
    "plan_digest",
    "policy_version",
    "policy_digest",
    "input_digest",
    "round",
    "verdict",
    "findings",
    "nodes"
  ]
}
