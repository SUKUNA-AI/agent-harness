{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_metric"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "metric": {
      "type": "string",
      "maxLength": 512
    },
    "value": {
      "type": [
        "integer",
        "number",
        "boolean",
        "string",
        "null"
      ]
    },
    "coverage": {
      "enum": [
        "observed",
        "partial",
        "unavailable"
      ]
    },
    "producer_id": {
      "type": "string",
      "maxLength": 512
    },
    "observation_scope": {
      "type": "string",
      "maxLength": 512
    },
    "source_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "trial_id",
    "manifest_digest",
    "metric",
    "value",
    "coverage",
    "producer_id",
    "observation_scope",
    "source_refs"
  ]
}
