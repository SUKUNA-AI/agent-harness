{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/native-agent-harness/contract-v1",
  "title": "Harness task contract v1",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "attempt_id", "workflow", "process_level", "goal", "permissions", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "lane_id": {"$ref": "#/$defs/id"},
    "owner": {"type": "string"},
    "native_ref": {"type": "string"},
    "workflow": {"enum": ["answer", "research", "plan", "review", "diagnostics", "change", "performance", "document", "learning", "operations", "monitor"]},
    "process_level": {"enum": ["light", "standard", "coordinated"]},
    "goal": {"type": "string", "minLength": 1},
    "persistence": {"const": true},
    "cwd": {"type": "string", "description": "Existing absolute workspace directory. Omit for evidence-only work without files."},
    "base_revision": {"type": "string"},
    "resource_lock_root": {"type": "string", "description": "Absolute machine-local shared lock directory for cross-partition resource coordination, outside source workspace."},
    "permissions": {"type": "array", "items": {"enum": ["read", "write", "test", "external"]}, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "scope": {
      "type": "object",
      "properties": {
        "write_paths": {"type": "array", "items": {"type": "string"}},
        "protected_paths": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "shared_files": {"type": "array", "items": {"type": "object", "required": ["path", "format", "allowed_records"], "properties": {"path": {"type": "string"}, "format": {"enum": ["json-records", "validator"]}, "allowed_records": {"type": "array", "minItems": 1}, "records_key": {"type": "string"}, "id_key": {"type": "string"}, "validator_argv": {"$ref": "#/$defs/argv"}, "validator_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
      }
    },
    "inputs": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}}},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["command", "source", "content", "visual", "runtime"]},
          "required": {"type": "boolean"},
          "argv": {"$ref": "#/$defs/argv"},
          "cwd": {"type": "string"},
          "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
          "expected_exit": {"type": "integer"},
          "effect": {"enum": ["read_only", "local_test"]},
          "resources": {"type": "array", "items": {"type": "string"}},
          "tool_versions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/argv"}},
          "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "assertions": {"type": "array", "items": {"type": "object", "required": ["regex"], "properties": {"stream": {"enum": ["stdout", "stderr", "combined"]}, "regex": {"type": "string"}, "min_matches": {"type": "integer", "minimum": 1}, "forbidden": {"type": "boolean"}}}},
          "reports": {"type": "array", "items": {"type": "object", "required": ["path", "format"], "properties": {"path": {"type": "string"}, "format": {"enum": ["junit", "json"]}, "min_tests": {"type": "integer", "minimum": 1}, "max_skipped": {"type": "integer", "minimum": 0}, "required_cases": {"type": "array", "items": {"type": "string"}}, "equals": {"type": "object"}}}}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"required": ["argv", "timeout"]}, "else": {"required": ["criteria"]}}
        ]
      }
    },
    "budget": {"type": "object", "properties": {"max_attempts": {"type": "integer", "minimum": 1}, "native_cap": {"type": "integer", "minimum": 1}, "root_counts": {"type": "boolean"}, "native_cap_source": {"type": "string"}, "deadline": {"type": "string"}}},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["run_dir", "verdict_digest"], "properties": {"run_dir": {"type": "string"}, "verdict_digest": {"$ref": "#/$defs/sha"}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
