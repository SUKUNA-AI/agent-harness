{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-typed-reference v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "semantic",
        "episode",
        "short_term",
        "ledger_event",
        "evidence",
        "fact"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "project_id",
    "kind",
    "id",
    "generation",
    "content_digest"
  ]
}
