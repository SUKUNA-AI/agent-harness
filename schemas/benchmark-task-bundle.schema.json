{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_task_bundle"
    },
    "suite": {
      "enum": [
        "swe-bench-verified",
        "terminal-bench-2.1",
        "aider-polyglot",
        "harness-recovery",
        "harness-retrieval-long-task"
      ]
    },
    "task_id": {
      "type": "string",
      "maxLength": 512
    },
    "revision": {
      "type": "string",
      "maxLength": 512
    },
    "provenance": {
      "enum": [
        "project_owned",
        "normalized_external"
      ]
    },
    "api_profile": {
      "const": "artifact-json-v1"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "path",
          "source"
        ]
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "milestones": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "fault": {
            "enum": [
              "observe",
              "controller_restart",
              "after_durable_checkpoint"
            ]
          }
        },
        "required": [
          "id",
          "artifact",
          "expected",
          "fault"
        ]
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "max_wall_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "turn_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "suite",
    "task_id",
    "revision",
    "provenance",
    "api_profile",
    "license",
    "objective",
    "files",
    "writable_paths",
    "oracle",
    "milestones",
    "max_attempts",
    "max_wall_seconds",
    "turn_timeout_seconds"
  ]
}
