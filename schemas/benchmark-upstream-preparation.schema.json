{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_upstream_preparation"
    },
    "suite": {
      "enum": [
        "swe-bench-verified",
        "terminal-bench-2.1",
        "aider-polyglot"
      ]
    },
    "task_id": {
      "type": "string",
      "maxLength": 512
    },
    "dataset_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "evaluator_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cohort_selection": {
      "enum": [
        "selected_full_pinned_index",
        "custom_selection",
        "synthetic_fixture"
      ]
    },
    "protocol": {
      "enum": [
        "swebench-jsonl-v1",
        "harbor-task-v1",
        "aider-exercism-v1"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "solve_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          }
        },
        "required": [
          "path",
          "asset"
        ]
      }
    },
    "protected_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          }
        },
        "required": [
          "path",
          "asset"
        ]
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "benchmark_upstream_evaluator"
        },
        "suite": {
          "enum": [
            "swe-bench-verified",
            "terminal-bench-2.1",
            "aider-polyglot"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "protocol": {
          "enum": [
            "swebench-jsonl-v1",
            "harbor-task-v1",
            "aider-exercism-v1"
          ]
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "helpers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 512
              },
              "artifact": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            },
            "required": [
              "name",
              "artifact"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "suite",
        "revision",
        "protocol",
        "entrypoint",
        "helpers"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            null,
            "python",
            "rust",
            "go",
            "javascript",
            "cpp",
            "java"
          ]
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "solution_files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "agent_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "verifier_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "language",
        "base_commit",
        "test_files",
        "solution_files",
        "agent_timeout_seconds",
        "verifier_timeout_seconds"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "suite",
    "task_id",
    "dataset_revision",
    "evaluator_revision",
    "source_ref",
    "profile_ref",
    "profile_digest",
    "cohort_selection",
    "protocol",
    "objective",
    "solve_files",
    "protected_files",
    "writable_paths",
    "evaluator",
    "parameters"
  ]
}
