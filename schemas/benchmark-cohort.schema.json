{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_cohort"
    },
    "suite": {
      "enum": [
        "swe-bench-verified",
        "terminal-bench-2.1",
        "aider-polyglot",
        "harness-recovery",
        "harness-retrieval-long-task"
      ]
    },
    "dataset_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "selection": {
      "enum": [
        "selected_full_pinned_index",
        "custom_selection",
        "synthetic_fixture"
      ]
    },
    "split": {
      "type": "string",
      "maxLength": 512
    },
    "declared_total": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "id",
          "source"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "suite",
    "dataset_revision",
    "selection",
    "split",
    "declared_total",
    "tasks"
  ]
}
