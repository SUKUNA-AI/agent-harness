{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_workspace_inventory"
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          }
        },
        "required": [
          "path",
          "asset"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "files"
  ]
}
