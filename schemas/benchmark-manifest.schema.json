{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "benchmark_manifest"
    },
    "comparison": {
      "enum": [
        "package",
        "matched"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "bootstrap_resamples": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "confidence": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "minimum_token_gain": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minimum_quality_delta": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "model": {
      "type": "string",
      "maxLength": 512
    },
    "provider": {
      "type": "string",
      "maxLength": 512
    },
    "client_version": {
      "type": "string",
      "maxLength": 512
    },
    "root_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "child_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "approved_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "suites": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "swe-bench-verified",
              "terminal-bench-2.1",
              "aider-polyglot",
              "harness-recovery",
              "harness-retrieval-long-task"
            ]
          },
          "revision": {
            "type": "string",
            "maxLength": 512
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "evaluator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "toolchain": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 512
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ]
                }
              },
              "required": [
                "id",
                "source"
              ]
            }
          }
        },
        "required": [
          "id",
          "revision",
          "assets",
          "evaluator",
          "adapter",
          "toolchain",
          "tasks"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "comparison",
    "seed",
    "repeats",
    "bootstrap_resamples",
    "confidence",
    "minimum_token_gain",
    "minimum_quality_delta",
    "model",
    "provider",
    "client_version",
    "root_policy",
    "child_policy",
    "isolation",
    "approved_budget",
    "suites"
  ]
}
