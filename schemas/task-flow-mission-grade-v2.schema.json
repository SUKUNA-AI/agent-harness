{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "task_flow_mission_evaluation"
    },
    "preparation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    },
    "verdict": {
      "enum": [
        "accepted",
        "rejected",
        "unknown"
      ]
    },
    "finished_at": {
      "type": "string",
      "format": "utc"
    },
    "execution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_version": {
          "const": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "maxLength": 512
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_scheme": {
          "const": "ordinary-tree-no-git-v1"
        },
        "evaluator_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_artifact_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "toolchain_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "subject_version",
        "manifest_digest",
        "task_id",
        "trial_id",
        "candidate_digest",
        "candidate_scheme",
        "evaluator_digest",
        "evaluator_artifact_digest",
        "bundle_digest",
        "toolchain_digest"
      ]
    },
    "candidate_scheme": {
      "const": "ordinary-tree-no-git-v1"
    },
    "evaluator_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "preparation_digest",
    "trial_id",
    "candidate_digest",
    "evaluator_bundle_digest",
    "producer_id",
    "requirements",
    "verdict",
    "finished_at",
    "execution_evidence",
    "subject",
    "candidate_scheme",
    "evaluator_input_digest"
  ]
}
