{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "work_state_migration_plan"
    },
    "source_version": {
      "const": 1
    },
    "destination_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "maxLength": 512
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "usage_policy": {
      "const": "legacy_history_unverified"
    },
    "downgrade_policy": {
      "const": "baseline_writer_refuses_v2"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "source_version",
    "destination_version",
    "run_id",
    "expected_generation",
    "targets",
    "usage_policy",
    "downgrade_policy"
  ]
}
