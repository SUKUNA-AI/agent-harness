{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-short-term v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "goal": {
      "type": "string",
      "maxLength": 16384
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "checkpoint": {
      "type": "string",
      "maxLength": 512
    },
    "active_task": {
      "type": "string",
      "maxLength": 512
    },
    "failures": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "important_files": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "next_step": {
      "type": "string",
      "maxLength": 16384
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "attempts_used": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_reported": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "maxLength": 512
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))(?![\\s\\S]*\\\\)(?![\\s\\S]*:)[\\s\\S]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "toolchain_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "file_inventory_complete": {
          "type": "boolean"
        },
        "omitted_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "binding_kind": {
          "enum": [
            "whole_snapshot"
          ]
        },
        "snapshot_algorithm": {
          "type": "string",
          "maxLength": 512
        },
        "snapshot_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inventory_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkout_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkout_root": {
          "type": "string",
          "maxLength": 512
        },
        "inventory_complete": {
          "type": "boolean"
        },
        "details_complete": {
          "type": "boolean"
        },
        "details_omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "details_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "repository_identity",
        "revision",
        "snapshot_id",
        "files"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512
          },
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "project_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "semantic",
                  "episode",
                  "short_term",
                  "ledger_event",
                  "evidence",
                  "fact"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "content_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "project_id",
              "kind",
              "id",
              "generation",
              "content_digest"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      }
    },
    "goal_generation": {
      "type": "integer",
      "minimum": 1
    },
    "goal_origin": {
      "type": "string",
      "maxLength": 512
    },
    "active_task_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "bootstrap_purpose": {
      "type": "string",
      "maxLength": 512
    },
    "context_epoch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "repository_identity",
    "goal",
    "constraints",
    "checkpoint",
    "active_task",
    "failures",
    "important_files",
    "next_step",
    "evidence_ids",
    "session_id",
    "attempts_used",
    "tokens_reported",
    "updated_at",
    "provenance"
  ]
}
