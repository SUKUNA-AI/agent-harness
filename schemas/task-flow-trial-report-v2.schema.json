{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "task_flow_trial_report"
    },
    "preparation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "arm": {
      "enum": [
        "A",
        "B-mechanical",
        "B-human",
        "C",
        "D"
      ]
    },
    "solver_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "measurement_kind": {
      "enum": [
        "synthetic",
        "observed"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "timeout",
        "cancelled",
        "environment_error",
        "unknown"
      ]
    },
    "claimed_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_policy": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluator_receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "utc"
    },
    "finished_at": {
      "type": "string",
      "format": "utc"
    },
    "manual_interventions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "human_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "human_feedback": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "expected_invocation_ids": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invocation_id": {
            "type": "string",
            "maxLength": 512
          },
          "scope": {
            "const": "individual_attempt"
          },
          "phase": {
            "enum": [
              "initial",
              "planner",
              "worker",
              "integration",
              "reviewer",
              "repair",
              "retry"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "conflicting"
            ]
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "invocation_id",
          "scope",
          "phase",
          "status",
          "input_tokens",
          "output_tokens"
        ]
      }
    },
    "usage_coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "phase_seconds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "enum": [
              "initial",
              "planner",
              "worker",
              "integration",
              "reviewer",
              "repair",
              "retry",
              "checks",
              "evaluator"
            ]
          },
          "seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "phase",
          "seconds"
        ]
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_version": {
          "const": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "maxLength": 512
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_scheme": {
          "const": "ordinary-tree-no-git-v1"
        },
        "evaluator_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_artifact_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "toolchain_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "subject_version",
        "manifest_digest",
        "task_id",
        "trial_id",
        "candidate_digest",
        "candidate_scheme",
        "evaluator_digest",
        "evaluator_artifact_digest",
        "bundle_digest",
        "toolchain_digest"
      ]
    },
    "candidate_scheme": {
      "const": "ordinary-tree-no-git-v1"
    },
    "evaluator_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "preparation_digest",
    "trial_id",
    "task_id",
    "arm",
    "solver_id",
    "measurement_kind",
    "outcome",
    "claimed_complete",
    "candidate_digest",
    "observed_policy",
    "evaluator_receipt",
    "started_at",
    "finished_at",
    "manual_interventions",
    "human_minutes",
    "human_feedback",
    "expected_invocation_ids",
    "usage",
    "usage_coverage",
    "phase_seconds",
    "subject",
    "candidate_scheme",
    "evaluator_input_digest"
  ]
}
